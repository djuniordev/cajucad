{
  "name": "cajucad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:start": "vite build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir --config.directories.output=%LOCALAPPDATA%/cajucad-build",
    "desktop:dist": "npm run build && node scripts/dist.mjs",
    "desktop:engine": "node scripts/prepare-engine.mjs",
    "desktop:dist:full": "npm run build && node scripts/dist.mjs --full"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "productName": "CajuCAD",
  "description": "Modelagem 3D com as fontes do seu computador.",
  "author": "CajuCAD",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.cajucad.desktop",
    "productName": "CajuCAD",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CajuCAD",
      "artifactName": "CajuCAD-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "djuniordev",
        "repo": "cajucad"
      }
    ]
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "mqtt": "^5.16.0"
  }
}
